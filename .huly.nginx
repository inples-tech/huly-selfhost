server {
    listen 80;
    server_name _;
    client_max_body_size 100M;

    # Встроенный DNS Docker. Нужен для upstream'ов, заданных переменной: такие имена
    # резолвятся в рантайме, поэтому лежащий сервис отдаёт 502 в своём location,
    # а не роняет весь nginx на старте ошибкой "host not found in upstream".
    # Так подключаем опциональные интеграции — ядро резолвится на старте штатно.
    resolver 127.0.0.11 valid=10s ipv6=off;

    location / {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        set $up_front front;
        proxy_pass http://$up_front:8080;
    }

    location /_accounts {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        set $up_account account;
        rewrite ^/_accounts/?(.*)$ /$1 break;
        proxy_pass http://$up_account:3000;
    }

    #location /_print {
    #    proxy_set_header Host $host;
    #    proxy_set_header X-Real-IP $remote_addr;
    #    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #    proxy_set_header X-Forwarded-Proto $scheme;

    #    proxy_http_version 1.1;
    #    proxy_set_header Upgrade $http_upgrade;
    #    proxy_set_header Connection "upgrade";
    #    rewrite ^/_print(/.*)$ $1 break;
    #    proxy_pass http://print:4005/;
    #}

    # ИИ-сервис: саммари, перевод и живая расшифровка созвонов.
    location /_aibot {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        set $up_aibot aibot;
        rewrite ^/_aibot(/.*)$ $1 break;
        proxy_pass http://$up_aibot:4010;
    }

    # Сервис видеозвонков. Раздаёт токены LiveKit и принимает вебхуки комнат;
    # сам медиатрафик сюда не заходит — он идёт напрямую на livekit.inples.ru
    # и на UDP-порт хоста.
    location /_love {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        set $up_love love;
        rewrite ^/_love(/.*)$ $1 break;
        proxy_pass http://$up_love:8096;
    }

    location /_collaborator {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        set $up_collaborator collaborator;
        rewrite ^/_collaborator/?(.*)$ /$1 break;
        proxy_pass http://$up_collaborator:3078;
    }

    location /_transactor {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        set $up_transactor transactor;
        rewrite ^/_transactor/?(.*)$ /$1 break;
        proxy_pass http://$up_transactor:3333;
    }

    location ~ ^/eyJ {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";

        set $up_transactor_ws transactor;
        proxy_pass http://$up_transactor_ws:3333;
    }

    location /_rekoni {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        set $up_rekoni rekoni;
        rewrite ^/_rekoni/?(.*)$ /$1 break;
        proxy_pass http://$up_rekoni:4004;
    }

    location /_stats {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        set $up_stats stats;
        rewrite ^/_stats/?(.*)$ /$1 break;
        proxy_pass http://$up_stats:4900;
    }

    #location /_pulse {
    #    proxy_set_header Host $host;
    #    proxy_set_header X-Real-IP $remote_addr;
    #    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    #    proxy_set_header X-Forwarded-Proto $scheme;
    #
    #    proxy_http_version 1.1;
    #    proxy_set_header Upgrade $http_upgrade;
    #    proxy_set_header Connection "upgrade";
    #    rewrite ^/_pulse(.*)$ /ws$1 break;
    #    proxy_pass http://hulypulse:8099/;
    #}

    # Бот-уведомления. Префикс длиннее, чем у /_telegram, поэтому nginx выбирает
    # именно его для этих запросов независимо от порядка блоков.
    location /_telegram-bot {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        set $up_telegram_bot telegram-bot;
        rewrite ^/_telegram-bot(/.*)$ $1 break;
        proxy_pass http://$up_telegram_bot:4020;
    }

    
    # Интеграция с GitHub: OAuth-колбэки из UI и вебхуки от GitHub App
    # на /_github/api/webhook.
    location /_github {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        set $up_github github;
        rewrite ^/_github(/.*)$ $1 break;
        proxy_pass http://$up_github:3500;
    }

    # Google Calendar. Сюда же Google шлёт вебхуки об изменениях (/_calendar/push),
    # поэтому location должен работать и без авторизации Huly.
    location /_calendar {
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        set $up_calendar calendar;
        rewrite ^/_calendar(/.*)$ $1 break;
        proxy_pass http://$up_calendar:8095;
    }

    # location /_export {
    #     proxy_set_header host $host;
    #     proxy_set_header x-real-ip $remote_addr;
    #     proxy_set_header x-forwarded-for $proxy_add_x_forwarded_for;
    #     proxy_set_header x-forwarded-proto $scheme;
    #
    #     proxy_http_version 1.1;
    #     proxy_set_header upgrade $http_upgrade;
    #     proxy_set_header connection "upgrade";
    #     rewrite ^/_export(/.*)$ $1 break;
    #     proxy_pass http://exports:4009/;
    # }
}

# nginx с вложенным конфигом.
#
# Конфиг раньше подкладывался bind-монтированием ./.huly.nginx. Это стабильно
# ломалось при деплое: Dokploy перевыкладывает репозиторий заново, файл получает
# новый inode, а монтирование контейнера остаётся на старом — удалённом. Внутри
# остаётся прежняя версия, при этом `nginx -t` из контейнера читает уже новый файл
# и отвечает «ок», а `nginx -s reload` ничего не меняет. Снаружи это выглядит так,
# будто новый маршрут просто не работает: запрос уходит в SPA-фронт и возвращает
# HTML вместо ответа сервиса. За 20-21.09.2026 наступили трижды — на /_pulse,
# /_calendar и /_export.
#
# Теперь конфиг вкладывается в образ: монтировать нечего, каждый деплой
# пересобирает образ и пересоздаёт контейнер вместе с конфигом. Сборка —
# только COPY плюс проверка синтаксиса.
FROM nginx:1.21.3

COPY .huly.nginx /etc/nginx/conf.d/default.conf

# Синтаксис проверяем на сборке. Имена сервисов при этом не резолвятся: ядро
# подключено через upstream'ы по именам, но nginx проверяет их только при старте,
# а опциональные интеграции идут через переменные и рантайм-резолвер.
RUN nginx -t -c /etc/nginx/nginx.conf 2>&1 | tail -2
